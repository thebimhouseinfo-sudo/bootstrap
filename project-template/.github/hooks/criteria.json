{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/criteria-gate.cjs sessionStart",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/criteria-gate.cjs subagentStop",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node .github/hooks/criteria-gate.cjs userPromptSubmitted",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/criteria-gate.cjs preToolUse",
        "timeoutSec": 10
      }
    ]
  }
}
