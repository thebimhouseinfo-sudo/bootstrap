{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python harness/claude/hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Create|MultiEdit|str_replace_editor|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python harness/claude/hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python harness/claude/hook.py",
            "timeout": 135
          }
        ]
      }
    ]
  }
}
